# =============================================================================
# The Morning Sword / AI Index Trading Platform - environment template
# =============================================================================
# Copy this file to `.env` and fill in your own values:
#
#     Copy-Item .env.example .env
#
# RULES
#   - `.env` is gitignored. NEVER commit it.
#   - NEVER paste a real credential into `.env.example`.
#   - Names only below; values are intentionally left blank.
#   - The GetAgent API base URL is fixed to https://api.bitget.com by the SDK
#     docs and is deliberately NOT configurable here.
# =============================================================================

# --- Credentials -------------------------------------------------------------
# Bitget OpenAPI credential sent as the `ACCESS-KEY` HTTP header for
# /api/v1/playbook/{upload,run,confirm,publish}. Treat as a secret.
BITGET_ACCESS_KEY=

# --- Safety switches ---------------------------------------------------------
# Every one of these defaults to the SAFE value. A blank or missing value is
# treated as disabled. Nothing destructive happens unless you explicitly opt in.

# Trading mode: paper | dry_run | live. Anything other than an explicit
# "live" keeps the system non-executing.
TRADING_MODE=

# Must be exactly "true" before any live order intent is allowed.
ALLOW_LIVE_TRADING=

# Must be exactly "true" before a Playbook publish call is allowed.
ALLOW_PLAYBOOK_PUBLISH=

# Must be exactly "I_UNDERSTAND_THIS_PUBLISHES_PUBLICLY" for the publish
# script to proceed past its confirmation gate.
PUBLISH_CONFIRMATION_PHRASE=

# --- Publish workflow identifiers (not secrets) ------------------------------
# Returned by POST /api/v1/playbook/upload and /confirm.
PLAYBOOK_STRATEGY_ID=
PLAYBOOK_DRAFT_ID=

# Semver bump applied at publish time: patch | minor | major.
PUBLISH_BUMP_TYPE=

# --- Runtime -----------------------------------------------------------------
NODE_ENV=
PYTHONIOENCODING=

# --- AI review layer (Milestone 3) -------------------------------------------
# The AI reviewer is VETO-ONLY: it may confirm, reject or watch a signal the
# deterministic strategy already produced. It can never create a signal, resize
# a position, move a stop, widen a risk limit, or place an order, and
# execution_mode must stay signal_only. Every failure mode fails closed.
#
# Default provider is "fixture": fully offline, deterministic, and always
# labelled SYNTHETIC. A hosted provider with a missing credential is a
# configuration error (exit 2), never a silent fallback to the fixture.

# fixture | openrouter | cloudflare
AI_PROVIDER=

# Optional model override. Blank keeps the provider default.
AI_MODEL=

# Optional base-URL override. Must stay on the allowlisted AI host
# (https://openrouter.ai/ or https://api.cloudflare.com/); anything else is
# rejected before a request is made.
AI_BASE_URL=

# Per-request timeout, in seconds.
AI_TIMEOUT_S=

# Hard cap on model calls for one run (runaway-cost guard; maximum 500).
AI_MAX_CALLS=

# Audit the last N watch signals per symbol AFTER the replay. Never simulated.
AI_WATCH_SAMPLE=

# Sampling temperature. Kept at 0.0 so a review can be reproduced exactly.
AI_TEMPERATURE=

# --- AI provider credentials (secrets - names only, values always blank) -----
# Read from the environment at call time. Never logged, never written to an
# artifact, never placed in a prompt. Error messages carry the HTTP status only.
OPENROUTER_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
